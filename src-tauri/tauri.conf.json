{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WITHIN SOOP",
  "version": "0.1.1",
  "identifier": "com.gyeot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WITHIN SOOP",
        "width": 920,
        "height": 700,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["withinsoop", "gyeot"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
